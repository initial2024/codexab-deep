// api/health.js

export default function handler(req, res) {
  res.setHeader("Access-Control-Allow-Origin", "*");
  res.setHeader("Access-Control-Allow-Methods", "GET,OPTIONS");
  res.setHeader("Access-Control-Allow-Headers", "Content-Type,Authorization");

  if (req.method === "OPTIONS") {
    return res.status(204).end();
  }

  return res.status(200).json({
    ok: true,
    service: "selfhost-cloud-backend",
    version: "selfhost-cloud-v1",
    time: new Date().toISOString(),
    capabilities: {
      health: true,
      chatProxy: true,
      parse: true,
      renderParse: true,
      modelCheck: true,
    },
    endpoints: {
      health: "/api/health",
      chatProxy: "/api/chat/proxy",
      parse: "/api/parse",
      renderParse: "/api/render-parse",
      modelCheck: "/api/model-check",
    },
    warning:
      "This is a self-hosted backend. Diagnostics are for configuration checking only and do not guarantee all websites, models, or upstream providers will work.",
  });
}
